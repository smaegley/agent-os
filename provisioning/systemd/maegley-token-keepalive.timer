[Unit]
Description=Fire the agent token keep-alive well inside the ~8h token window (WR-013/ADR-0010 §6)

[Timer]
# ONCE DAILY — Steve's cost ruling 2026-08-25, and MEASUREMENT 2026-08-26 says daily is
# the right cadence for the failure mode that actually happened.
#
# The two probes that settled it (WR-013 criterion 8):
#   PROBE A  healthy token, 7.9h remaining  -> NO RENEWAL (expiry byte-identical)
#   PROBE B  EXPIRED token, 7 min past      -> RENEWED +29222s (~8.1h), exit 0
# Renewal is EXPIRY-DRIVEN, not use-driven. A call against a healthy token is a no-op,
# which is why every measurement on 2026-08-25 looked like a broken mechanism.
#
# What that means, and why 4h was solving the wrong problem: an expired token RENEWS ON
# USE — Eric dispatched from an expired token on 2026-08-25 22:30 and completed a full QA
# session. So hourly aging is self-healing and needs no help. What killed all seven over
# 2026-08-22→25 was MULTI-DAY silence, long enough for the refresh credential itself to
# die; that is what needs a daily heartbeat. Daily exercises every credential once a day,
# which is exactly and only what the real failure mode requires.
#
# Do NOT "restore" 4h to keep tokens continuously live. That was the operator's own wrong
# model on 2026-08-25 and it buys nothing: it fires three extra times a day against healthy
# tokens, each a measured no-op.
OnCalendar=daily
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
